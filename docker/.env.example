# =============================================================================
# Docker Compose 环境变量（给中间件容器用）
# 应用本地 profile 默认值与此保持一致；生产请用 SPRING_PROFILES_ACTIVE=prod + 环境变量
# =============================================================================
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=power

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# 宿主机上的 Java 应用连接 Compose 映射端口时使用（application-local.yml 默认值同源）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest

NACOS_ADDR=127.0.0.1:8848
